{
  "name": "rel-enc",
  "description": "Relativo a encuestas",
  "version": "1.3.19",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "main": "dist/server/rel-enc.js",
  "types": "dist/server/rel-enc.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "operativos": "^1.4.0",
    "row-validator": "^0.7.4"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "mixin-patch": "~0.4.0",
    "mocha": "^11.8.0",
    "types.d.ts": "~0.6.7",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 12.0.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "(tsc -p src/client  || echo \"continue w/error\") & (tsc -p src/server || echo \"continue w/error\") && mixin-patch",
    "test": "tsc -p src/tests && mocha --reporter spec --bail --check-leaks compile-for-test/tests/*.js",
    "start": "node dist/server/server-rel-enc.js"
  },
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "lib",
    "ecmaVersion": 6
  }
}
